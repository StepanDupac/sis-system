{
  "manifest_version": 3,
  "name": "Termín — pomocník se zápisem",
  "version": "0.2.0",
  "description": "Český pomocník pro SIS UK. Trénink a načtení struktury stránky; skutečný zápis zatím není aktivní.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "power", "activeTab", "scripting"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Otevřít Termín", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "options_ui": { "page": "manual.html", "open_in_tab": true },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  }
}
